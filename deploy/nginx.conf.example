# Safe default: loopback only and deny-all. Do NOT enable public access without
# deciding allowed sources AND protected transport (TLS/VPN/SSH tunnel).
server {
    listen 127.0.0.1:8080;
    server_name _;
    root /opt/taskleaf/current/dist;
    index index.html;
    client_max_body_size 5m;
    # Once configured, allow a trusted source BEFORE deny all; do not simply remove it.
    deny all;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location / {
        try_files $uri $uri/ =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        # Preserve the port for host validation and same-origin checks.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    location ~ /\. { deny all; }
}
